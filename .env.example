# Create .env from this file with: python scripts/init_env.py
# It fills each placeholder below with a random secret. Never commit .env.

# --- docker compose -----------------------------------------------------------
POSTGRES_PASSWORD=replace-me-admin
MCP_DB_PASSWORD=replace-me-read-only

# --- the server -----------------------------------------------------------------
# The read-only role. `sales-mcp setup` creates it with MCP_DB_PASSWORD.
DATABASE_URL=postgresql://mcp_reader:replace-me-read-only@127.0.0.1:5432/shop
# Only `sales-mcp setup` uses the admin connection.
ADMIN_DATABASE_URL=postgresql://postgres:replace-me-admin@127.0.0.1:5432/shop

MCP_ENABLED=true
MCP_TOKEN=replace-me-with-a-long-random-token

# Door 2, for Claude.ai custom connectors (they cannot send headers).
# The URL becomes /mcp/t/<MCP_URL_TOKEN>. It is reachable from outside only while a
# tunnel runs (docker compose --profile tunnel up). Set false to close it.
MCP_URL_TOKEN=replace-me-with-another-long-random-token
MCP_URL_TOKEN_ENABLED=true

# The hosts the server answers to. *.trycloudflare.com covers any quick tunnel.
# Add your own domain (host only, no https://) if you expose it another way.
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,*.trycloudflare.com
MCP_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*,https://claude.ai,https://claude.com
MCP_RATE_PER_MIN=60
